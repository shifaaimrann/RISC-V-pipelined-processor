module riscv_top(
 input clk,
    input reset
);

    reg  [63:0] PC;
    wire [63:0] PCNext;
    wire [63:0] PCPlus4;
    wire [63:0] PCBranch;      // from EXMEM_PCBranch
    wire        PCSrc;         // branch decision

    // Hazard signals
    wire        Stall;
    wire        PCWrite;
    wire        IFIDWrite;
    wire        ControlMuxSel;

    assign PCPlus4 = PC + 64'd4;
    assign PCSrc   = EXMEM_Branch & EXMEM_ZeroFlag;  // branch taken
    assign PCNext  = PCSrc ? EXMEM_PCBranch : PCPlus4;

    // PC register with stall support
    always @(posedge clk or posedge reset) begin
        if (reset)
            PC <= 64'd0;
        else if (PCWrite)
            PC <= PCNext;
        // else: hold PC when stalled
    end


    // INSTRUCTION MEMORY (IF stage)
    wire [31:0] Instruction;

    // Replace with actual instruction memory
    instr_mem imem (
        .addr       (PC),
        .instruction(Instruction)
    );


    // IF/ID PIPELINE REGISTER
    wire [31:0] IFID_Instruction;
    wire [63:0] IFID_PCout;

    IFID ifid_reg (
        .clk            (clk),
        .reset          (reset),
        .IFIDWrite      (IFIDWrite),       // from hazard unit
        .Instruction    (Instruction),
        .PC_Out         (PCPlus4),         // pass PC+4 forward
        .IFID_Instruction(IFID_Instruction),
        .IFID_PCout     (IFID_PCout)
    );


    // DECODE STAGE (ID)

    // Extract register numbers from IFID_Instruction
    wire [4:0] IFID_Rs1 = IFID_Instruction[19:15];
    wire [4:0] IFID_Rs2 = IFID_Instruction[24:20];
    wire [4:0] IFID_Rd  = IFID_Instruction[11:7];
    wire [6:0] opcode   = IFID_Instruction[6:0];

    // Control signals from control unit (before hazard mux)
    wire       Branch;
    wire       MemRead;
    wire       MemWrite;
    wire       MemtoReg;
    wire       RegWrite;
    wire       ALUSrc;
    wire [1:0] ALUOp;

    //control unit 
    control_unit CU (
        .opcode   (opcode),
        .Branch   (Branch),
        .MemRead  (MemRead),
        .MemWrite (MemWrite),
        .MemtoReg (MemtoReg),
        .RegWrite (RegWrite),
        .ALUSrc   (ALUSrc),
        .ALUOp    (ALUOp)
    );

    // Immediate generator
    wire [63:0] Imm;
    imm_gen IG (
        .instruction(IFID_Instruction),
        .imm_out    (Imm)
    );

    // Register file
    wire [63:0] ReadData1;
    wire [63:0] ReadData2;

    // Writeback data from MEM/WB stage
    wire [63:0] WriteBackData;
    assign WriteBackData = MEMWB_MemtoReg ? MEMWB_ReadData : MEMWB_ALUResult;

    reg_file RF (
        .clk      (clk),
        .we       (MEMWB_RegWrite),
        .rs1      (IFID_Rs1),
        .rs2      (IFID_Rs2),
        .rd       (MEMWB_Rd),
        .wd       (WriteBackData),
        .rd1      (ReadData1),
        .rd2      (ReadData2)
    );


    // HAZARD UNIT – LOAD-USE DETECTION
    hazard_unit HU (
        .IDEX_MemRead (IDEX_MemRead),
        .IDEX_Rd      (IDEX_Rd),
        .IFID_Rs1     (IFID_Rs1),
        .IFID_Rs2     (IFID_Rs2),

        .Stall        (Stall),
        .PCWrite      (PCWrite),
        .IFIDWrite    (IFIDWrite),
        .ControlMuxSel(ControlMuxSel)
    );


    // CONTROL MUX (BUBBLE)
    wire IDEX_Branch_in;
    wire IDEX_MemRead_in;
    wire IDEX_MemWrite_in;
    wire IDEX_MemtoReg_in;
    wire IDEX_RegWrite_in;
    wire IDEX_ALUSrc_in;
    wire [1:0] IDEX_ALUOp_in;

    // If ControlMuxSel = 1 during a stall, send zeros into ID/EX (NOP)
    assign IDEX_Branch_in   = ControlMuxSel ? 1'b0  : Branch;
    assign IDEX_MemRead_in  = ControlMuxSel ? 1'b0  : MemRead;
    assign IDEX_MemWrite_in = ControlMuxSel ? 1'b0  : MemWrite;
    assign IDEX_MemtoReg_in = ControlMuxSel ? 1'b0  : MemtoReg;
    assign IDEX_RegWrite_in = ControlMuxSel ? 1'b0  : RegWrite;
    assign IDEX_ALUSrc_in   = ControlMuxSel ? 1'b0  : ALUSrc;
    assign IDEX_ALUOp_in    = ControlMuxSel ? 2'b00 : ALUOp;


    // ID/EX PIPELINE REGISTER
    wire [3:0] Funct;
    alu_funct_decode FD (
        .instruction(IFID_Instruction),
        .funct      (Funct)
    );

    // Outputs of ID_EX
    wire        IDEX_Branch;
    wire        IDEX_MemRead;
    wire        IDEX_MemWrite;
    wire        IDEX_MemtoReg;
    wire        IDEX_RegWrite;
    wire        IDEX_ALUSrc;
    wire [1:0]  IDEX_ALUOp;
    wire [3:0]  IDEX_Funct;
    wire [4:0]  IDEX_Rs1;
    wire [4:0]  IDEX_Rs2;
    wire [4:0]  IDEX_Rd;
    wire [63:0] IDEX_PCout;
    wire [63:0] IDEX_ReadData1;
    wire [63:0] IDEX_ReadData2;
    wire [63:0] IDEX_Imm;

    ID_EX id_ex_reg (
        .clk         (clk),
        .reset       (reset),

        // control (after hazard mux)
        .Branch      (IDEX_Branch_in),
        .MemRead     (IDEX_MemRead_in),
        .MemWrite    (IDEX_MemWrite_in),
        .MemtoReg    (IDEX_MemtoReg_in),
        .RegWrite    (IDEX_RegWrite_in),
        .ALUSrc      (IDEX_ALUSrc_in),
        .ALUOp       (IDEX_ALUOp_in),

        // instruction fields
        .Funct       (Funct),
        .Rs1         (IFID_Rs1),
        .Rs2         (IFID_Rs2),
        .Rd          (IFID_Rd),

        // datapath
        .IFID_PCout  (IFID_PCout),
        .ReadData1   (ReadData1),
        .ReadData2   (ReadData2),
        .Imm         (Imm),

        // outputs to EX stage
        .IDEX_Branch    (IDEX_Branch),
        .IDEX_MemRead   (IDEX_MemRead),
        .IDEX_MemWrite  (IDEX_MemWrite),
        .IDEX_MemtoReg  (IDEX_MemtoReg),
        .IDEX_RegWrite  (IDEX_RegWrite),
        .IDEX_ALUSrc    (IDEX_ALUSrc),
        .IDEX_ALUOp     (IDEX_ALUOp),

        .IDEX_Funct     (IDEX_Funct),
        .IDEX_Rs1       (IDEX_Rs1),
        .IDEX_Rs2       (IDEX_Rs2),
        .IDEX_Rd        (IDEX_Rd),

        .IDEX_PCout     (IDEX_PCout),
        .IDEX_ReadData1 (IDEX_ReadData1),
        .IDEX_ReadData2 (IDEX_ReadData2),
        .IDEX_Imm       (IDEX_Imm)
    );


    // EXECUTE STAGE (EX)
    wire [63:0] ALU_in2;
    assign ALU_in2 = IDEX_ALUSrc ? IDEX_Imm : IDEX_ReadData2;

    wire [3:0] ALUControl;
    alu_control AC (
        .ALUOp (IDEX_ALUOp),
        .Funct (IDEX_Funct),
        .ALUCtl(ALUControl)
    );

    wire [63:0] ALUResult_EX;
    wire        ZeroFlag_EX;

    alu ALU (
        .a       (IDEX_ReadData1),
        .b       (ALU_in2),
        .alu_ctrl(ALUControl),
        .result  (ALUResult_EX),
        .zero    (ZeroFlag_EX)
    );

    // Branch target = IDEX_PCout + IDEX_Imm (already computed outside or here)
    wire [63:0] PCBranch_EX;
    assign PCBranch_EX = IDEX_PCout + IDEX_Imm;

    // EX/MEM PIPELINE REGISTER
    wire        EXMEM_Branch;
    wire        EXMEM_MemRead;
    wire        EXMEM_MemWrite;
    wire        EXMEM_MemtoReg;
    wire        EXMEM_RegWrite;
    wire [63:0] EXMEM_PCBranch;
    wire        EXMEM_ZeroFlag;
    wire [63:0] EXMEM_ALUResult;
    wire [63:0] EXMEM_WriteData;
    wire [4:0]  EXMEM_Rd;

    ex_mem_reg exmem_reg (
        .clk           (clk),
        .reset         (reset),

        .IDEX_Branch   (IDEX_Branch),
        .IDEX_MemRead  (IDEX_MemRead),
        .IDEX_MemWrite (IDEX_MemWrite),
        .IDEX_MemtoReg (IDEX_MemtoReg),
        .IDEX_RegWrite (IDEX_RegWrite),

        .IDEX_PCBranch (PCBranch_EX),
        .ZeroFlag_EX   (ZeroFlag_EX),
        .ALUResult_EX  (ALUResult_EX),
        .WriteData_EX  (IDEX_ReadData2),
        .IDEX_Rd       (IDEX_Rd),

        .EXMEM_Branch    (EXMEM_Branch),
        .EXMEM_MemRead   (EXMEM_MemRead),
        .EXMEM_MemWrite  (EXMEM_MemWrite),
        .EXMEM_MemtoReg  (EXMEM_MemtoReg),
        .EXMEM_RegWrite  (EXMEM_RegWrite),

        .EXMEM_PCBranch  (EXMEM_PCBranch),
        .EXMEM_ZeroFlag  (EXMEM_ZeroFlag),
        .EXMEM_ALUResult (EXMEM_ALUResult),
        .EXMEM_WriteData (EXMEM_WriteData),
        .EXMEM_Rd        (EXMEM_Rd)
    );


    // MEMORY STAGE (MEM)
    wire [63:0] ReadData_MEM;

    data_mem DMEM (
        .clk     (clk),
        .addr    (EXMEM_ALUResult),
        .wd      (EXMEM_WriteData),
        .MemRead (EXMEM_MemRead),
        .MemWrite(EXMEM_MemWrite),
        .rd      (ReadData_MEM)
    );


    // MEM/WB PIPELINE REGISTER
    wire        MEMWB_MemtoReg;
    wire        MEMWB_RegWrite;
    wire [63:0] MEMWB_ReadData;
    wire [63:0] MEMWB_ALUResult;
    wire [4:0]  MEMWB_Rd;

    mem_wb_reg memwb_reg (
        .clk (clk),
        .reset (reset),
        .EXMEM_MemtoReg (EXMEM_MemtoReg),
        .EXMEM_RegWrite (EXMEM_RegWrite),
        .ReadData_MEM   (ReadData_MEM),
        .ALUResult_MEM  (EXMEM_ALUResult),
        .EXMEM_Rd       (EXMEM_Rd),
        .MEMWB_MemtoReg (MEMWB_MemtoReg),
        .MEMWB_RegWrite (MEMWB_RegWrite),
        .MEMWB_ReadData (MEMWB_ReadData),
        .MEMWB_ALUResult(MEMWB_ALUResult),
        .MEMWB_Rd       (MEMWB_Rd)
    );


endmodule
